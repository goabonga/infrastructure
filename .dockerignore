# Keep the build context to what the Dockerfiles actually COPY. Without this
# the context carries .git, node_modules and the rendered docs site, which is
# both slow to transfer and a way for stale local artefacts to reach an image.

.git
.github
.multicz

# Local build output and rendered artefacts.
build/
dist/
site/
docs/

# Never ship a locally-built SPA: the www image builds it from source in its
# own stage, and a stale cmd/www/dist would silently win.
cmd/www/dist/
www/node_modules/
www/dist/

# Tests and tooling that no image needs.
test/
scripts/
deploy/
packaging/

*.md
*.tfstate
*.tfstate.*
