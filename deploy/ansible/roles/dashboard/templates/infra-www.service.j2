[Unit]
Description=infra web dashboard (embedded SPA + API reverse proxy)
After=network-online.target infra-api.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/infra-www
Environment=GOA_WWW_ADDR={{ www_addr }}
Environment=GOA_API_URL=http://127.0.0.1{{ api_addr }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
