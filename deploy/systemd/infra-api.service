[Unit]
Description=infra control-plane API server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/infra-api
Restart=on-failure
RestartSec=5
Environment=GOA_STATE_DIR=/var/lib/infra
StateDirectory=infra

[Install]
WantedBy=multi-user.target
