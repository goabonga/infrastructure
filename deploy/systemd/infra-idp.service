[Unit]
Description=infra identity provider (JWT issuer)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/infra-idp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
