[Unit]
Description=infra Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/infra-exporter
Restart=on-failure
RestartSec=5
Environment=GOA_STATE_DIR=/var/lib/infra
StateDirectory=infra
# Read-only access to state is enough for the exporter.
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/infra

[Install]
WantedBy=multi-user.target
